# Ignore everything except the custom theme, uploaded media, and database backups
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/IMAGE_SPECS.md
!/LAUNCH_READINESS.md
!/db-backups/
!/wp-content/
/wp-content/*
!/wp-content/themes/
!/wp-content/uploads/
/wp-content/uploads/wpforms/cache/
/wp-content/themes/*
!/wp-content/themes/tanya-barrans/
