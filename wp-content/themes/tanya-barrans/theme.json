{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "White" },
				{ "slug": "alabaster", "color": "#FAF7F2", "name": "Warm Ivory" },
				{ "slug": "sand", "color": "#E8DFD2", "name": "Linen" },
				{ "slug": "ink", "color": "#465D7C", "name": "Modern Navy" },
				{ "slug": "charcoal", "color": "#0F1E35", "name": "Dark Navy" },
				{ "slug": "stone", "color": "#E8DFD2", "name": "Linen Light" },
				{ "slug": "bronze", "color": "#6B7B5E", "name": "Sage" },
				{ "slug": "coral", "color": "#D8A7B1", "name": "Dusty Blush" },
				{ "slug": "coral-deep", "color": "#465D7C", "name": "Modern Navy" },
				{ "slug": "slate", "color": "#6B7B5E", "name": "Sage" },
				{ "slug": "muted", "color": "#2D2D2D", "name": "Graphite" },
				{ "slug": "sound", "color": "#6B7B5E", "name": "Sage" },
				{ "slug": "sage", "color": "#6B7B5E", "name": "Sage" },
				{ "slug": "graphite", "color": "#2D2D2D", "name": "Graphite" }
			],
			"gradients": [
				{
					"slug": "hero-scrim",
					"gradient": "linear-gradient(180deg, rgba(15,30,53,0.2) 0%, rgba(15,30,53,0.62) 100%)",
					"name": "Hero Scrim"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/cormorant-garamond-latin-regular.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "400", "fontStyle": "italic", "src": [ "file:./assets/fonts/cormorant-garamond-latin-italic.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "600", "fontStyle": "normal", "src": [ "file:./assets/fonts/cormorant-garamond-latin-600.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "700", "fontStyle": "normal", "src": [ "file:./assets/fonts/cormorant-garamond-latin-700.woff2" ] }
					]
				},
				{
					"slug": "sans",
					"name": "Montserrat",
					"fontFamily": "\"Montserrat\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/montserrat-latin-regular.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "500", "fontStyle": "normal", "src": [ "file:./assets/fonts/montserrat-latin-500.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "600", "fontStyle": "normal", "src": [ "file:./assets/fonts/montserrat-latin-600.woff2" ] }
					]
				},
				{
					"slug": "script",
					"name": "Playlist Script",
					"fontFamily": "\"Playlist Script\", cursive",
					"fontFace": [
						{ "fontFamily": "Playlist Script", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/playlist-script.otf" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.3125rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.375rem", "fluid": { "min": "1.75rem", "max": "2.375rem" } },
				{ "slug": "xx-large", "name": "Heading", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } },
				{ "slug": "hero", "name": "Hero", "size": "5rem", "fluid": { "min": "2.75rem", "max": "5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "size": "0.75rem", "name": "XS" },
				{ "slug": "30", "size": "1.25rem", "name": "S" },
				{ "slug": "40", "size": "2rem", "name": "M" },
				{ "slug": "50", "size": "3.5rem", "name": "L" },
				{ "slug": "60", "size": "5.5rem", "name": "XL" },
				{ "slug": "70", "size": "8rem", "name": "XXL" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--alabaster)",
			"text": "var(--wp--preset--color--graphite)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--coral)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.8125rem",
					"fontWeight": "600",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "2rem",
						"right": "2rem"
					}
				},
				"border": { "radius": "0px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--coral)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.375rem",
					"fontWeight": "700",
					"letterSpacing": "0.01em"
				}
			},
			"core/navigation": {
				"color": {
					"text": "var(--wp--preset--color--charcoal)",
					"background": "var(--wp--preset--color--alabaster)"
				},
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "500",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "1.5"
				},
				"border": {
					"left": { "color": "var(--wp--preset--color--coral)", "width": "2px", "style": "solid" }
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--coral)" } }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page (No Title)", "postTypes": [ "page" ] }
	]
}
